# =========================================================================
# NOTEMART PRODUCTION & VERCEL ENVIRONMENT CONFIGURATION
# Copy these values into your Vercel Project Settings > Environment Variables
# =========================================================================

# 1. RAZORPAY PAYMENT GATEWAY CREDENTIALS (Live or Test)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_live_your_key_id
RAZORPAY_KEY_ID=rzp_live_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret_key
RAZORPAY_WEBHOOK_SECRET=whsec_your_webhook_secret

# 2. EMAIL OTP CONFIGURATION (BREVO SMTP / API OR RESEND)
# --- Option A: Brevo SMTP (Tested & Working) ---
BREVO_SMTP_LOGIN=b83f0e001@smtp-brevo.com
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_PASS=xsmtpsib-your_smtp_key_here
BREVO_SMTP_KEY=xsmtpsib-your_smtp_key_here
# IMPORTANT: This email MUST be verified in Brevo Dashboard > Senders & IPs > Senders
SMTP_VERIFIED_SENDER=vikashkumar902743@gmail.com
SMTP_FROM_NAME=NoteMart Verification

# --- Option B: Brevo REST API v3 (starts with xkeysib-) ---
# BREVO_API_KEY=xkeysib-your_brevo_v3_api_key_here

# --- Option C: Resend API (Fastest serverless email delivery) ---
# RESEND_API_KEY=re_your_resend_api_key_here

# 3. SUPER ADMIN CREDENTIALS (for /super-admin portal)
# Login email for the Super Admin panel
SUPER_ADMIN_EMAIL=superadmin@notemart.in
# SHA-256 hash of your super admin password (default 'admin123' hash shown below):
# Generate new hash: node -e "console.log(require('crypto').createHash('sha256').update('YOUR_PASSWORD').digest('hex'))"
SUPER_ADMIN_PASSWORD_HASH=240be518fabd2724ddb6f04eeb1da5967448d7e831c08c8fa822809f74c720a9

# 4. PRODUCTION WEBSITE URL
NEXT_PUBLIC_APP_URL=https://your-domain.vercel.app

