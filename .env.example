# =========================================================================
# NOTEMART PRODUCTION & DEVELOPMENT ENVIRONMENT CONFIGURATION
# =========================================================================

# 1. RAZORPAY PAYMENT GATEWAY CREDENTIALS
# Obtain these from your Razorpay Dashboard: https://dashboard.razorpay.com/app/keys
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_notemart_demo
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
RAZORPAY_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# 2. REAL EMAIL OTP VERIFICATION (SMTP CONFIGURATION)
# Works with Gmail (App Passwords), SendGrid, Mailtrap, AWS SES, or any standard SMTP server
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-digit-gmail-app-password
SMTP_FROM="NoteMart Verification" <your-email@gmail.com>

# 3. WEBSITE DEPLOYMENT URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# 4. SUPABASE DATABASE CREDENTIALS (OPTIONAL FOR CLOUD DB)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
